# All variables are optional in V1. The app works fully offline/local with
# zero configuration (mock AI, IndexedDB storage). Add these as later phases
# are wired up. Never commit a real .env or .env.local file.

# --- AI (Phase 5/6) ---
# Set ONE of these to switch event extraction + blog writing from the
# built-in offline heuristic to a real model. Checked in this order:
# Gemini first, then Anthropic. Server-side only — never exposed to the browser.

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override, e.g. a "-pro" variant for higher quality/cost. Defaults
# to "gemini-3.6-flash".
GEMINI_MODEL=

# Get a key at https://console.anthropic.com (requires separate API credits —
# a Claude Pro/Max subscription does NOT cover API usage).
ANTHROPIC_API_KEY=

# --- Supabase (cloud sync — set both to move off local-only IndexedDB) ---
# Setting these switches getRepository() to SupabaseRepository and gates the
# app behind sign-in (magic link, no password). Both are safe for the
# browser — real security comes from Row Level Security
# (supabase/migrations/0001_init.sql), not from keeping these secret. The
# app never uses a service-role key: every read/write happens as the signed-
# in user, enforced by RLS, exactly like a real multi-device app should.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Speech-to-text (Phase 4) ---
# Optional. If set, audio recordings can be auto-transcribed instead of
# relying on manual transcript entry.
OPENAI_API_KEY=

# --- GitHub archival (Phase 9) ---
# A fine-grained personal access token scoped to just the archive repo.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
