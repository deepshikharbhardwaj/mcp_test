# All variables are optional in V1. The app works fully offline/local with
# zero configuration (mock AI, IndexedDB storage). Add these as later phases
# are wired up. Never commit a real .env or .env.local file.

# --- AI (Phase 5/6) ---
# When set, event extraction + blog writing use real Claude instead of the
# built-in offline heuristic. Server-side only — never exposed to the browser.
ANTHROPIC_API_KEY=

# --- Supabase (Phase 2+, when migrating off local IndexedDB) ---
# Public URL/anon key are safe for the browser; the service role key is NOT
# and must only ever be read in server-side code (API routes), never in
# client components.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Speech-to-text (Phase 4) ---
# Optional. If set, audio recordings can be auto-transcribed instead of
# relying on manual transcript entry.
OPENAI_API_KEY=

# --- GitHub archival (Phase 9) ---
# A fine-grained personal access token scoped to just the archive repo.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
